# Copie para .env (que nunca é commitado) e preencha.

# --- Anthropic ---
ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-4-5-20251001   # pauta, extração de fatos, memória
MODEL_SMART=claude-sonnet-5-5          # roteiro, reescrita e juiz de falas fact
JUDGE_BANTER_MODEL=claude-haiku-4-5-20251001  # juiz de banter (auditoria: 0 FN também com Haiku)

# Preços em US$ por milhão de tokens (usados para registrar o custo em llm_calls).
PRICE_FAST_INPUT_PER_MTOK=1.00
PRICE_FAST_OUTPUT_PER_MTOK=5.00
PRICE_SMART_INPUT_PER_MTOK=2.00
PRICE_SMART_OUTPUT_PER_MTOK=10.00

# --- Orçamento e chave geral ---
MAX_DAILY_USD=8.00      # ao atingir, para de gerar até o dia seguinte (fuso de Brasília)
GENERATE=on             # on|off

# --- Reprise (Sprint 1.1) ---
REPLAY_WHEN_IDLE=off    # on: sem audiência (VIEWERS=0), reprisa em vez de gerar
VIEWERS=1               # por ora uma variável; no Sprint 3 vira a contagem real
REPLAY_WINDOW=6h        # só reprisa segmentos aprovados nessa janela

# --- Loop ---
INGEST_INTERVAL=5m
MEMORY_HALF_LIFE_DAYS=7 # meia-vida do peso das memórias dos avatares
TVTL_TIMEZONE=America/Sao_Paulo
TVTL_UID=1000          # dono dos relatórios em ./output
TVTL_GID=1000
HTTP_USER_AGENT=tvtl/0.1 (+https://github.com/gloffreda/tv-ta-ligado)

# --- Postgres (só dentro da rede tvtl_net) ---
POSTGRES_USER=tvtl
POSTGRES_PASSWORD=tvtl
POSTGRES_DB=tvtl
TVTL_PG_PORT=55432      # só no perfil debug (make debug-up), publicado em 127.0.0.1

# --- Limites de recurso dos containers ---
TVTL_PG_MEM=512m
TVTL_PG_CPUS=1
TVTL_MEM=256m
TVTL_CPUS=1
TVTL_PGTEST_MEM=512m
TVTL_PGTEST_CPUS=1
TVTL_GO_MEM=3g          # toolchain de build/teste (o SDK da Anthropic precisa de >1,5 GB para compilar)
TVTL_GO_CPUS=2

# --- Voz (Sprint 2) ---
TTS_PROVIDER=kokoro          # melhor local aprovado no benchmark (ver DECISIONS.md)
TTS_FALLBACK=kokoro,piper
# Nuvem: só entra se a chave existir.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# GOOGLE_TTS_KEY=            # ou GOOGLE_APPLICATION_CREDENTIALS=/caminho/sa.json
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# ELEVENLABS_API_KEY=
TTS_PRICE_AZURE_PER_MCHAR=15
TTS_PRICE_GOOGLE_PER_MCHAR=16
TTS_PRICE_POLLY_PER_MCHAR=16
TTS_PRICE_ELEVENLABS_PER_MCHAR=40
TVTL_KOKORO_CPUS=2
TVTL_KOKORO_MEM=1536m
TVTL_CHATTERBOX_CPUS=4
TVTL_CHATTERBOX_MEM=6g
TVTL_PIPER_CPUS=1
TVTL_PIPER_MEM=512m
TVTL_LIPSYNC_CPUS=1
TVTL_LIPSYNC_MEM=512m

# --- Linha do tempo e API ---
BUFFER_MIN=10m
CLOCK_OFFSET=0s              # homologação: +2h (make staging-up já define)
TVTL_API_PORT=58080          # só no perfil debug, em 127.0.0.1

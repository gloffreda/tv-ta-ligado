# Copie para .env (que nunca é commitado) e preencha.

# --- Anthropic ---
ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-4-5-20251001   # pauta, extração de fatos, memória
MODEL_SMART=claude-sonnet-5-5          # roteiro, reescrita e juiz

# Preços em US$ por milhão de tokens (usados para registrar o custo em llm_calls).
PRICE_FAST_INPUT_PER_MTOK=1.00
PRICE_FAST_OUTPUT_PER_MTOK=5.00
PRICE_SMART_INPUT_PER_MTOK=2.00
PRICE_SMART_OUTPUT_PER_MTOK=10.00

# --- Orçamento e chave geral ---
MAX_DAILY_USD=5.00      # ao atingir, para de gerar até o dia seguinte (fuso de Brasília)
GENERATE=on             # on|off

# --- Loop ---
INGEST_INTERVAL=5m
MEMORY_HALF_LIFE_DAYS=7 # meia-vida do peso das memórias dos avatares
TVTL_TIMEZONE=America/Sao_Paulo
TVTL_UID=1000          # dono dos relatórios em ./output
TVTL_GID=1000
HTTP_USER_AGENT=tvtl/0.1 (+https://github.com/gloffreda/tv-ta-ligado)

# --- Postgres (só dentro da rede tvtl_net) ---
POSTGRES_USER=tvtl
POSTGRES_PASSWORD=tvtl
POSTGRES_DB=tvtl
TVTL_PG_PORT=55432      # só no perfil debug (make debug-up), publicado em 127.0.0.1

# --- Limites de recurso dos containers ---
TVTL_PG_MEM=512m
TVTL_PG_CPUS=1
TVTL_MEM=256m
TVTL_CPUS=1
TVTL_PGTEST_MEM=512m
TVTL_PGTEST_CPUS=1
TVTL_GO_MEM=3g          # toolchain de build/teste (o SDK da Anthropic precisa de >1,5 GB para compilar)
TVTL_GO_CPUS=2
